<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 600" width="1200" height="600">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#0A0A0A"/>
      <stop offset="100%" style="stop-color:#1A0505"/>
    </linearGradient>
    <linearGradient id="accent" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" style="stop-color:#FF3B30"/>
      <stop offset="100%" style="stop-color:#FF6B35"/>
    </linearGradient>
  </defs>
  <rect width="1200" height="600" fill="url(#bg)"/>
  <rect x="0" y="520" width="1200" height="4" fill="url(#accent)" opacity="0.6"/>
  <!-- Dumbbell Icon -->
  <g transform="translate(600,260)" opacity="0.15">
    <rect x="-180" y="-25" width="360" height="50" rx="8" fill="#FF3B30"/>
    <rect x="-220" y="-55" width="50" height="110" rx="10" fill="#FF6B35"/>
    <rect x="170" y="-55" width="50" height="110" rx="10" fill="#FF6B35"/>
    <rect x="-280" y="-80" width="60" height="160" rx="12" fill="#FF3B30"/>
    <rect x="220" y="-80" width="60" height="160" rx="12" fill="#FF3B30"/>
  </g>
  <text x="600" y="290" text-anchor="middle" font-family="Arial Black,Arial" font-weight="900" font-size="96" fill="#FFFFFF" letter-spacing="8">IRONCORE</text>
  <text x="600" y="350" text-anchor="middle" font-family="Arial,sans-serif" font-size="22" fill="#FF6B35" letter-spacing="12">PREMIUM GYM MANAGEMENT</text>
</svg>
